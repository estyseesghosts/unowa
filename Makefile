# unowa M0 build: native Old 3DS .3dsx, one edition + one profile per tree.
#
#   make EDITION=0 PROFILE=0 program   -> build/black/unowa-black.3dsx
#   make EDITION=1 PROFILE=1 program   -> build/white/unowa-white-dbg.3dsx
#
# Release and profile objects never share a tree; a later build cannot reuse
# objects compiled under the other profile's flags. Use tools/build.sh, which
# holds an OS lock on the tree while make runs.
#
# Toolchain: devkitARM r68-1, libctru 2.7.1, citro3d 1.7.1 (upstream.lock).
# Run from devkitPro's MSYS2 shell with DEVKITPRO set.

EDITION ?= 0
PROFILE ?= 0

ifeq ($(EDITION),0)
  EDITION_NAME := black
else ifeq ($(EDITION),1)
  EDITION_NAME := white
else
  $(error EDITION must be 0 (black) or 1 (white))
endif

ifeq ($(PROFILE),1)
  TREE_SUFFIX := -prof
  EXE_SUFFIX  := -dbg
  PROFILE_DEFS := -DUNOWA_PROFILE=1
else
  TREE_SUFFIX :=
  EXE_SUFFIX  :=
  PROFILE_DEFS := -DUNOWA_RELEASE=1
endif

OUT        := build/$(EDITION_NAME)/3ds$(TREE_SUFFIX)
GEN        := $(OUT)/gen
PROGRAM    := unowa-$(EDITION_NAME)$(EXE_SUFFIX)
ELF        := $(OUT)/$(PROGRAM).elf
THREEDSX   := $(OUT)/$(PROGRAM).3dsx

DEVKITPRO  ?= /opt/devkitpro
DEVKITARM  ?= $(DEVKITPRO)/devkitARM
CC         := $(DEVKITARM)/bin/arm-none-eabi-gcc
BUILD_ID_H := $(GEN)/build_id.h

SOURCES := \
    engine/app/main.c \
    engine/runtime/abi_assert.c \
    engine/runtime/unowa_edition.c \
    engine/diagnostics/log.c \
    engine/storage/paths.c \
    engine/graphics/renderer.c

OBJECTS := $(SOURCES:%.c=$(OUT)/obj/%.o)
DEPS    := $(OBJECTS:.o=.d)

# ARM11 MPCore with VFP. Four-byte enums are not relevant yet (no DS side in
# M0) but -fno-short-enums is kept so the ABI does not drift when M1 lands.
ARM_FLAGS := -march=armv6k -mtune=mpcore -mfpu=vfp -mfloat-abi=hard -mtp=soft \
             -mword-relocations -fno-short-enums -D__3DS__

CFLAGS := -std=gnu11 -O2 -g -Wall -Wextra -Wno-unused-parameter \
          -ffunction-sections -fdata-sections $(ARM_FLAGS) \
          -DUNOWA_EDITION=$(EDITION) $(PROFILE_DEFS) \
          -Iengine -I$(GEN) -I$(DEVKITPRO)/libctru/include

LDFLAGS := $(ARM_FLAGS) -specs=3dsx.specs -L$(DEVKITPRO)/libctru/lib \
           -Wl,--gc-sections -Wl,--no-enum-size-warning
LIBS := -lcitro3d -lctru -lm

.PHONY: all program clean clean-all
all: program
program: $(THREEDSX)

BUILD_SHA := $(shell git -C $(CURDIR) rev-parse --short=12 HEAD 2>/dev/null || echo unknown)
BUILD_DIRTY := $(shell test -n "$$(git -C $(CURDIR) status --porcelain 2>/dev/null)" && echo -dirty || echo)

$(BUILD_ID_H): FORCE
	@mkdir -p $(dir $@)
	@printf '/* Generated by the build: never edit. */\n#define UNOWA_BUILD_ID "unowa-%s-%s%s%s"\n' \
	    '$(EDITION_NAME)' '$(BUILD_SHA)' '$(BUILD_DIRTY)' \
	    '$(if $(filter 1,$(PROFILE)),-dbg)' > $@.new
	@if cmp -s $@.new $@; then rm -f $@.new; else mv $@.new $@; fi

.PHONY: FORCE
FORCE:

$(OUT)/obj/%.o: %.c $(BUILD_ID_H)
	@mkdir -p $(dir $@)
	@echo "  CC $<"
	@$(CC) $(CFLAGS) -MMD -MP -MQ"$@" -c $< -o $@

$(ELF): $(OBJECTS)
	@echo "  LINK $@"
	@$(CC) $(LDFLAGS) $(OBJECTS) $(LIBS) -o $@

$(THREEDSX): $(ELF)
	@echo "  3DSX $@"
	@$(DEVKITPRO)/tools/bin/3dsxtool $< $@
	@echo "built $@"

clean:
	rm -rf $(OUT)

clean-all:
	rm -rf build

-include $(wildcard $(DEPS))
